# Vorlage – niemals einen echten Schlüssel hier oder ins Repository schreiben.
# Der gültige Zugang liegt auf dem Server (derselbe wie bisher):
#   K:\LLP Wirtschaftsprüfung\AI Tools\_Gemeinsam\llp_ai\.env
#
# Zusätzlich erkannt: AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_DEPLOYMENT,
# AZURE_OPENAI_API_KEY. COMPANY_AI_ENABLED nur auf false setzen, um
# Foundry bewusst auszuschalten.

COMPANY_AI_ENABLED=
COMPANY_AI_PROVIDER=foundry
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=
FOUNDRY_API_KEY=
