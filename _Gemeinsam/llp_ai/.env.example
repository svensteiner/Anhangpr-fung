# Bestehenden Zugang verwenden – nicht neu anlegen, wenn die Datei
# auf dem Server schon existiert:
#   K:\LLP Wirtschaftsprüfung\AI Tools\_Gemeinsam\llp_ai\.env
#
# Alle folgenden Namen werden gelesen (erster gesetzter Wert gilt):
#   Endpoint:   FOUNDRY_ENDPOINT / AZURE_OPENAI_ENDPOINT
#   Deployment: FOUNDRY_DEPLOYMENT / AZURE_OPENAI_DEPLOYMENT
#   Schlüssel:  FOUNDRY_API_KEY / AZURE_OPENAI_API_KEY
#
# COMPANY_AI_ENABLED leer lassen, wenn der Zugang schon da ist.
# Nur auf false setzen, um Foundry bewusst auszuschalten.

COMPANY_AI_ENABLED=
COMPANY_AI_PROVIDER=foundry
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=
FOUNDRY_API_KEY=
FOUNDRY_API_VERSION=v1
